# SSTATE_DIR=/data/yocto/sstate-cache
# DL_DIR=/data/yocto/downloads
#IMAGE_VERSION_SUFFIX=
#KAS_MACHINE=raspberrypi3-64

# RAUC bundle signing (absolute paths). If not set, the public development
# keys are used. Run "just rauc-create-pki" to create your own CA and signer.
#RAUC_KEY_FILE=/path/to/pki/private/signer-1.key.pem
#RAUC_CERT_FILE=/path/to/pki/signer-1.cert.pem
#RAUC_INTERMEDIATE_FILE=/path/to/pki/intermediate.cert.pem
#RAUC_KEYRING_FILE=/path/to/pki/ca.cert.pem
